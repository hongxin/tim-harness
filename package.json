{
  "name": "tim-harness",
  "private": true,
  "version": "0.1.0",
  "description": "Tim Harness — 装进一个浏览器页面的随身大模型工程 Harness",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:smoke": "vite build --config vite.smoke.config.ts",
    "smoke": "npm run build:smoke && node dist-smoke/smoke.mjs",
    "build:wechat-smoke": "vite build --config vite.wechat-smoke.config.ts",
    "smoke:wechat": "npm run build:wechat-smoke && node dist-wechat-smoke/wechat-smoke.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}